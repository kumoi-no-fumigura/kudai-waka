 ],
 "poems": [
  {
   "seq": "1",
   "text": "山高みふりくる霧にむすれはや鳴鶯の聲まれらなる",
   "kana": "",
   "speaker": "散位從五位上大江朝臣千里",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "鶯の啼つる聲にさそはれて花のもとにそ我はきにげる",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "ゑつかなる時を尋ていつこにか花のありかをともに尋む",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "花のえた折つるからにちりまかふ匂ひのあかすおもほゆる哉",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "神さひてふりぬる里に住人は都に匂ふ花をたに見す",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "今ははやかへりきなまし道なりし花を見しまに程そへにける",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "こつたひて綠の糸のよはけれは鶯とつるちからたになし",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "花かのみ尋こしまに春はまたふかさ淺さもしられさりけり",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "はかなくて空なる風の年をへて春吹送ることそあやしき",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "あたゝけき春の山邊の花のみそ心もわかす咲みたれける",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "あと絕てしつけき山に咲花のちりはつるまて見る人もなし",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "としふかく老ぬる人のかなしきは咲る花さへをとる成けり",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "花を見て歸らんことのわするゝは色こき花によりて成けり",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "年月にまさるときなしと思へはや春しも常にすくれたるらん",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "あかてのみ過行はるをいかてかは心をいれてをしまさるへき",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "かれてよりわが惜こし春はたゝあけむ朝そ限なるへき",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "春をのみこゝもかしこもおしめともみな同し時盡ぬるかうさ",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "はる〓〓にあひて老ぬる身なれはや醉に泪のあかれさるらん",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "哀とも我身のみこそおもほゆれはかなき春を過しきぬれは",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "歎つゝ過行春をおしめともあまつ空からふりすてゝ行",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "ひとゝせに又ふたゝひもこし物をたゝひる中に春はのこれる",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "このめはるさかへこしゝも仇なれは花の陰とそ成まさりける",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "うくひすはすきにしはるを惜みつゝ鳴こゑ多き比にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "空蟬のみとしなりぬる物ならは秋をまたてそ鳴ぬへらなる",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "鶯はときなられはや鳴聲の今はまれらになりぬへらなる",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "ちりまかふ花はこのはにかくされて稀に匂へる色そともなき",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "限りとて春の過にしときよりそなく鳥のねのいたくきこゆる",
   "kana": "",
   "speaker": "句題和歌夏",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "秋ならてはちすひらくる水の上は紅ふかき色にそありける",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "吹風に枝もむなしくなりゆけはおつる花こそ稀に見えけれ",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "なく鳥の聲ふかくのみきこゆるは殘れる花の枝をわふるか",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "月影になへてまさこのてりぬれは夏のよふかき霜かとそみる",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "我心しつけき時はふく風のみにはあらねと涼しかりけり",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "山たかみ谷をわけつゝゆく水はふきくる風そ凉しかりける",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "あまの河ほとの遙になりゆけはあひみん事の定めなきかな",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "秋のよの霜にたとへて我かみは年のはかなくおひし積れは",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "おほひたの秋くるからに我身社かなしき物と思ひしみぬれ",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "をく霜に草のかれ行時よりそ鳴むしのねも高くきこゆる",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "ひとゝせにたゝ今夜社たなはたの天の河原を渡るといふなれ",
   "kana": "",
   "speaker": "",
   "page": 511,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "物思ふ心の秋になりぬれはすへて人社みえわたりけれ",
   "kana": "",
   "speaker": "句題和歌秋",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "おほかたの秋を悲しとみることも仇なる人はしらすそ有ける",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "常よりも秋の木の葉にをく霜の紅ふかく見ゆるころ哉",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "かすかなる時のみ見ゆる秋しのは物思ふ〓とそ苦しかりける",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "すきてゆく秋の悲しく見えつるは老なん〓とのをしきんけり",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "もみちつゝ色くれなゐにみゆる日は鳴蟬さへやなくは成ぬる",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "鳴鴈の聲たに絕てきこえねは旅なる人を思ひまさりぬ",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "なく蟬の聲高くのみき、ゆるは秋すむ虫の秋そしるらし",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "いつしかと冬を迎ふるあしたからまつよき風の吹そうれしき",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "小夜更て猶ねられねと春風の吹くるかともおもほゆる哉",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "ひとゝせに春くる事は今そしるふしをきすれはあかし難きに",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "新しさうれへは多く寒きよの長きより社はしめ成けれ",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "物を思ふ心ははひとくたくれとあつきたきには及はさりけり",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "我髮のみな白雪と成ゆけはをける霜ともおとろかれけり",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "年〓〓と數へこしまにはかなくて人は老ぬる物にそありける",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "あくまてにみてる酒、こそ寒きよは人の身まてに暖まりけれ",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "老てぬる日ははや覺てとこしなへよはに過れは音をのみそ鳴",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "よひ〓〓にまた置霜の寒けれは草葉をたにそからささりける",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "秋のよを寒みなきつる虫のねは我宿に社あまたきこゆれ",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "ゆくかりの秋すきかたに獨しも友におくれて鳴渡るらん",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "吹風の音たかくさへきこゆれは置露さへも寒くも有かな",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "このはみなから紅にしくるとて霜のさらにも置まさるかな",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "秋のよをさむみなきつゝ行鴈の霜をしのきて行かへるらん",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "しのゝめに秋をく露の寒けれはたゝひとりしも虫のなくなる",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "秋すきはちりなん物をなく鳥のまつもみちはの枝にしも鳴",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "秋のよを且はなきつゝすくれともまつ言傳は見ゆるよもなし",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "行雁の飛ことはやく見えしより秋はかきりと思ひ成にき",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "獨ゐてもゆる螢にむかへはやかくをともなき身とそ成ぬる",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "かく計老ぬにと思へは今更に光の過ることもおほえす",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "おきへより吹くる風はしら浪の花とのみこそ見え渡りけれ",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "照月は浪の心にひかされてひとつかたにも見え渡るかな",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "わひてすむ宿にもかりのくれ行は吹風のみそとさし成ける",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "照もせす曇もはてぬ春のよの朧月夜そめてたかりける",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "鵠の嶺飛こえて鳴ゆけはみやまかくるゝ月かとそみる",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "雲はれてよき月影も常ならすあらん限りはおしみ社せめ",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "あつからす寒もあらすよき程に吹くる風はやますもあらなん",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "ふたつとも見えぬを月の山〓とにてり渡りつゝあきらけき哉",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "定めなく吹くる風はかき分てなとかしけきに人に告らん",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "てる月の都はかりはありといへと尋てゆかん程そしられぬ",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "おしみてもとめまほしきを春風の吹過かたく成ぬと思へは",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "雲もなく谷は山さへはれ行は水の色こそあらた成けれ",
   "kana": "",
   "speaker": "句題和歌風月",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "白雲の中を分つゝ夕暮のめてたきとは山にそ有げる",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "とひしりて雲のかけ橋とひゆかむ何れのかたか山はさかしき",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "ゆく水の靑き山より落くれは白雲かとそみえまかひける",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "よそにても花を哀とみる程にしらぬ山にそ我はきにける",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "さしわけて深く哀とみえつるは晴てしつけき所なりけり",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "影しけき水のあたりは年をへてすき來ぬれ共みえすそ有ける",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "吹風の光をとめんと思へはそ志はしもはるに遊ふへらなる",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "あやなくも年の緒なかく獨してあくかれ渡る身とや成南",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "天津空ちかく見えつゝはへつるは暮行やまの麓なりけり",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "かきりとて野への遙に見えつれは立白雲もふかくそ有ける",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "山ことに花の錦ををれゝはそ見ゆる處のやすき空なし",
   "kana": "",
   "speaker": "",
   "page": 512,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "谷水のことの音絕す聞ゆれは時のまをたにへたてすそ見る",
   "kana": "",
   "speaker": "雜",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "なく涙こふる袂にかゝりては紅ふかきあやと社見れ",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "別るともいひつる時ははるけきを近きをみぬそ戀しかりける",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "別にし君を思ひてたつぬれは夢のたましゐはるけかりけり",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "あさことにむすほゝれつゝすくしつる",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "別にし君に見せすて徒にかたちのかはる身社つらけれ",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "自雲のわかるゝことに立つれと君ともにこそゆきかくれぬれ",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "別ての後も君見むと思へとも是をいつれの時とかは見る",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "人を送るともに春さへ過ぬれはこれか恨みはあまるんけり",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "近からすはるけき程に年をへて獨ある人は苦しかりけり",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "別ての後はしらぬをいかならん時にか又はあはんとすらむ",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "そこゐなく物をそ思ふ有てのみ別るゝ事を思ふ我身は",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "定なき心ひとつをなしつるそ命をのふる物にそありける",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "世の中を思ひ知ぬる心こそ身よりは過て老まさりけれ",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "心をしあまのうき木になしつれは流るゝ水に心まされり",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "はかなくていつも我身の獨して朝夕にしつ心なき",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "よるへなく空にうかへる心こそ夢見るよりもはかなかりけれ",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "悲しきも嬉しきことも多かるを心ひとつそなたつかりける",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "我身をは浮へる雲になせれはそゆく方もなくはかなかりける",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "まほろしのよとし知ぬる心にはさかなき夢と思ふ成けり",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "かりそめに志はし浮へるたましゐの水の泡とも譬へられつゝ",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "黑かみのしろく俄に成ぬれは春の花とそみえわたりける",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "我君も春の光にひとしくはさきなろ身ともしらぬへらなり",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "夢にても嬉しきことを見る時はこゝにちりくる身には增れり",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "しもわけて都尋にくる鴈も春にあひては飛かへりけり",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "春每にあひてもあはぬ我身かな花の雪のみ降まかひつゝ",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "春のみや花は咲らむ谷寒みうつもる草は光をも見す",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "しら浪の立かへりくる數よりも我身をなけくことは增れり",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "あし田鶴のひとりをくれて鳴聲は雲のうへまて聞へつかなん",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "天雲や身をかくすらん日の光我身てらせと見るよしもなき",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "年每に春秋とのみかそへつゝ身はひとゝきにあふよしもなし",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "思ふ〓と啼鶯につけたれは色もかはらぬ我ひとりてふ",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "都迄浪立くともさかなくにしはしたになと身のしつむ覽",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "哀とも我みのみ社おもほゆれはかなき春をすくしきぬれは",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "郭公さつきまたすになきにけるはかなく春をすくしきぬれは",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "鶯の谷よりいつる聲なくは春くることをいかて志らまし",
   "kana": "",
   "speaker": "參議藤判",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "いくらなつなき歸るらん足引の山ほとゝきす聲ははれすも",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "うへしとき花まちとをにありしきく移ふ秋にあはんとやみし",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "光りまつえたにかゝれる雪を社冬のはれとはいふへかりけれ",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "ほのにみし人に思ひをつけ初て心からこそしたにこかるれ",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "宿りせし花たちはなもかれなくになと郭公聲たえにけん",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "後まきのをくれておふる苗なれと仇にはならぬ賴みとそきく",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "ねに鳴てひちにしかとも春雨にぬれにし袖ととはゝ答へん",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "紅葉はを風にまかせてみるよりもはかなき物は命なりけり",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "あしたつの獨をくれて鳴聲は雲の上まて聞えつかなん",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "白雪のともに我みはふりぬれと心はきえぬ物にそ有ける",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "露かけし袂ほすまもなきものをなと秋風のまたき咲らん",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "流れてのよをも賴ます水上のあはにきへぬるうきみと思へは",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "都さて波立くともきかなくにしはしたになとみの沈むらん",
   "kana": "",
   "speaker": "",
   "page": 513,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "沈むみと聞から袖に波かけてうしろ安くはいかて思はん",
   "kana": "",
   "speaker": "千古朝臣",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "いつくにか今夜の月の曇るへきをくらの山も名をやかふらん",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "花をめて紅葉めつる折/ヽもつねなる松は猶もめてたし",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "盃のかけさしそへて思ふとち花にまとゐのあかぬへら也",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "難波江やおきつすとりのねぬこゑも旅なる人そ哀とはきく",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "大舟はかけてとまりのたゆたひの旅なる人はねられさりけり",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "秋の日は山のはちかしくれぬまにはゝにみえなんあゆめ赤駒",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "雲まとひ夕の雨もおつる江にからすも鵠もしほれてそ行",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "海山のめつらかなるに向ひても都にみはと思ふ心あり",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "けさはしもおきけん方もしらさりつ思ひ出るそきえて悲しき",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "明るよりいてゝやまつるみつ鹽のひるま計りもみねは戀しき",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "あふことはゆめか星合の朝風にこひしき波のよるみしほとに",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "秋をゝきてとき社ありけれ菊の花移ふ秋にあはんとやみし",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "なにしおふ色そめかへし雨ふらん花もてはやす君もこなくに",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "秋もこは花にもみはや小男鹿のふみしたかんなおしき夏草",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "折人のてにも袖にも梅香はかきりなくこそしみわたりけれ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "立よれはにほひを袖にうつす社花もさすかの心あるなれ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "向ひゐてあかすそ思ふいへ櫻くるとあくとにめをも放たて",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "今はとてこき出る舟のさはりなみ扇の風はへにもかけなん",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "東路にへたてはつとも武藏あふみふみたかふなと思てそやる",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "すみの江の濵のまさこは限りなく君か世〓へん數にとるへし",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  }
 ],
